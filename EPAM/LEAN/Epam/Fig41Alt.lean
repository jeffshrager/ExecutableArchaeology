/-
P-1817 Fig. 4.1 under other letter codes consistent with U1.

Generated by `analysis/gen_alt.py` from `analysis/codes_fig41.txt`. These codes
keep every bit that EPAM II's letter net U1 tests on each letter's path (so
each letter still sorts to its own terminal; `alt_respects_U1`), and A keeps
its historical code. The untested bits are filled so that **all 34** of
Feigenbaum's recorded responses are possible under the postulates
(`alt_agreement`). In random sampling (robustness.py), about 10% of
U1-consistent completions do this under the figure's assumptions.

Under these codes KAG's cue for LUK is precarious, as note 12 says: KAG can
fail on trial 6, and so its correct response on trial 7 is possible but not
certain (`alt_trial7_KAG_by_chance`).
-/

import Epam.Fig41

namespace Epam.Fig41Alt

open Epam Fig41 SylSet

/-- A: U1 fixes `1.001.00......`. -/
def A : Item := [true, false, false, false, true, true, false, false, false, true, false, true, true, true]
def AFixed : List (Nat × Bool) := [(0, true), (2, false), (3, false), (4, true), (6, false), (7, false)]
/-- E: U1 fixes `1..10..1......`. -/
def E : Item := [true, true, true, true, false, true, true, true, false, false, false, false, false, false]
def EFixed : List (Nat × Bool) := [(0, true), (3, true), (4, false), (7, true)]
/-- G: U1 fixes `011.11........`. -/
def G : Item := [false, true, true, true, true, true, true, true, false, true, false, true, true, true]
def GFixed : List (Nat × Bool) := [(0, false), (1, true), (2, true), (4, true), (5, true)]
/-- I: U1 fixes `1..00.1.......`. -/
def I : Item := [true, true, false, false, false, false, true, false, true, false, true, true, true, true]
def IFixed : List (Nat × Bool) := [(0, true), (3, false), (4, false), (6, true)]
/-- K: U1 fixes `1..10..0......`. -/
def K : Item := [true, true, true, true, false, true, true, false, false, true, false, false, true, true]
def KFixed : List (Nat × Bool) := [(0, true), (3, true), (4, false), (7, false)]
/-- L: U1 fixes `1..1110.......`. -/
def L : Item := [true, false, true, true, true, true, false, true, true, false, true, true, false, true]
def LFixed : List (Nat × Bool) := [(0, true), (3, true), (4, true), (5, true), (6, false)]
/-- M: U1 fixes `1..01.1.....0.`. -/
def M : Item := [true, true, true, false, true, true, true, false, false, true, false, false, false, true]
def MFixed : List (Nat × Bool) := [(0, true), (3, false), (4, true), (6, true), (12, false)]
/-- O: U1 fixes `0100..........`. -/
def O : Item := [false, true, false, false, true, true, false, true, true, false, false, true, false, true]
def OFixed : List (Nat × Bool) := [(0, false), (1, true), (2, false), (3, false)]
/-- P: U1 fixes `000.1..1......`. -/
def P : Item := [false, false, false, true, true, false, true, true, false, true, true, false, true, false]
def PFixed : List (Nat × Bool) := [(0, false), (1, false), (2, false), (4, true), (7, true)]
/-- R: U1 fixes `000.1..0......`. -/
def R : Item := [false, false, false, false, true, true, true, false, true, true, false, false, false, false]
def RFixed : List (Nat × Bool) := [(0, false), (1, false), (2, false), (4, true), (7, false)]
/-- T: U1 fixes `1..01.01......`. -/
def T : Item := [true, false, false, false, true, true, false, true, true, true, true, false, false, false]
def TFixed : List (Nat × Bool) := [(0, true), (3, false), (4, true), (6, false), (7, true)]
/-- U: U1 fixes `0010..........`. -/
def U : Item := [false, false, true, false, true, true, false, true, true, false, false, true, false, true]
def UFixed : List (Nat × Bool) := [(0, false), (1, false), (2, true), (3, false)]

/-- Every bit U1 tests has the value U1 requires. -/
theorem alt_respects_U1 :
    (AFixed.all fun p => A.feat p.1 == p.2) ∧
    (EFixed.all fun p => E.feat p.1 == p.2) ∧
    (GFixed.all fun p => G.feat p.1 == p.2) ∧
    (IFixed.all fun p => I.feat p.1 == p.2) ∧
    (KFixed.all fun p => K.feat p.1 == p.2) ∧
    (LFixed.all fun p => L.feat p.1 == p.2) ∧
    (MFixed.all fun p => M.feat p.1 == p.2) ∧
    (OFixed.all fun p => O.feat p.1 == p.2) ∧
    (PFixed.all fun p => P.feat p.1 == p.2) ∧
    (RFixed.all fun p => R.feat p.1 == p.2) ∧
    (TFixed.all fun p => T.feat p.1 == p.2) ∧
    (UFixed.all fun p => U.feat p.1 == p.2) = true := by
  decide

def alt : SylSet := ⟨K ++ A ++ G, L ++ U ++ K, R ++ I ++ L, P ++ E ++ M, R ++ O ++ M, T ++ I ++ L⟩

/-- **All 34 of Fig. 4.1's recorded responses are possible.** -/
theorem alt_agreement : ((fig alt).filter (agrees alt)).length = 34 := by decide

/-- Note 7 holds here too: PEM can only give ROM's response, TIL. -/
theorem alt_trial4_PEM : responsesAt alt 4 3 = [some alt.TIL] := by decide

/-- Note 12: KAG's link is precarious. On trial 6 it can fail; on trial 7 the
correct response is possible but not certain. -/
theorem alt_trial7_KAG_by_chance :
    (responsesAt alt 6 0).contains none ∧
      (responsesAt alt 7 0).contains (some alt.LUK) ∧ (responsesAt alt 7 0).contains none := by
  decide

end Epam.Fig41Alt
